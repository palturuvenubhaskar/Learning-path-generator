# ==============================================================================
# Learning Path Generator - environment
# Copy to .env and fill in, or paste the key in the app sidebar.
# ==============================================================================

# 1. OpenRouter (required). Free key: https://openrouter.ai/keys
# You can also paste it in the sidebar; the app saves it here.
OPENROUTER_API_KEY=

# Optional. Pick a model in the sidebar and the app saves it here.
OPENROUTER_MODEL=

# 2. MCP servers (optional). Create them at https://mcp.pipedream.com/
PIPEDREAM_YOUTUBE_MCP_URL=
PIPEDREAM_DRIVE_MCP_URL=
PIPEDREAM_NOTION_MCP_URL=

# 3. Storage (optional). Defaults to ./data
# LPG_DATA_DIR=
