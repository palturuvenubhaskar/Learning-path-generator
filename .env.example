# ==============================================================================
# AI Learning Path Generator - Environment Configuration
# Copy this file to .env and fill in your values, or enter them in the app UI.
# ==============================================================================

# 1. Google Gemini API Key (Required for AI generation)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (Supported: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# 2. Pipedream Model Context Protocol (MCP) Server Endpoints (Optional)
# Set up servers at: https://pipedream.com/
# Follow the official Pipedream MCP guide: Connect account -> Copy streamable HTTP URL
PIPEDREAM_YOUTUBE_MCP_URL=
PIPEDREAM_DRIVE_MCP_URL=
PIPEDREAM_NOTION_MCP_URL=
